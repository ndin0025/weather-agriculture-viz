{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1160,
  "height": 500,
  "title": {"text": "Does More Rainfall Mean More Income?", "subtitle": "Each dot is a state-year observation"},
  "data": {"url": "https://raw.githubusercontent.com/ndin0025/weather-agriculture-viz/refs/heads/main/final_merged_data.csv"},
  "params": [{"name": "State_select", "value": null, "bind": {"input": "select", "options": [null, "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"], "labels": ["Show all", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"], "name": "State: "}}],
  "transform": [{"filter": "State_select == null || datum.State == State_select"}],
  "layer": [
    {
      "mark": {"type": "circle", "size": 85, "opacity": 0.72, "tooltip": true},
      "encoding": {
        "x": {"field": "annual_avg_rainfall", "type": "quantitative", "title": "Average rainfall (mm)"},
        "y": {"field": "overall_farm_income", "type": "quantitative", "title": "Farm income ($M)", "axis": {"format": ".2s"}},
        "color": {"field": "State", "type": "nominal", "scale": {"scheme": "tableau10"}},
        "tooltip": [{"field": "State"}, {"field": "Year"}, {"field": "annual_avg_rainfall", "title": "Rainfall (mm)", "format": ",.0f"}, {"field": "overall_farm_income", "title": "Farm income ($M)", "format": ",.0f"}]
      }
    },
    {
      "transform": [{"regression": "overall_farm_income", "on": "annual_avg_rainfall"}],
      "mark": {"type": "line", "strokeDash": [6, 4], "strokeWidth": 2, "color": "#333"},
      "encoding": {
        "x": {"field": "annual_avg_rainfall", "type": "quantitative"},
        "y": {"field": "overall_farm_income", "type": "quantitative"}
      }
    }
  ],
  "config": {"font": "Inter", "view": {"stroke": null}}
}
