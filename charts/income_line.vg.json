{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": 1160,
  "height": 500,
  "title": {"text": "Farm Income Over Time", "subtitle": "Select a state in the legend to highlight it"},
  "data": {"url": "https://raw.githubusercontent.com/ndin0025/weather-agriculture-viz/refs/heads/main/final_merged_data.csv"},
  "params": [{"name": "state_highlight", "select": {"type": "point", "fields": ["State"]}, "bind": "legend"}],
  "mark": {"type": "line", "point": true, "tooltip": true, "strokeWidth": 2.5},
  "encoding": {
    "x": {"field": "Year", "type": "ordinal", "title": "Year", "axis": {
        "labelAngle": 0,
        "labelFontSize": 14,
        "titleFontSize": 16
      }},
    "y": {"field": "overall_farm_income", "type": "quantitative", "title": "Farm income ($M)", "axis": {"format": ".2s", "labelAngle": 0,"labelFontSize": 14, "titleFontSize": 16}},
    "color": {
      "field": "State",
      "type": "nominal",
      "title": "State",
      "scale": {
        "scheme": "set2"
      },
      "legend": {
        "titleFontSize": 18,
        "labelFontSize": 16,
        "symbolSize": 180,
        "symbolStrokeWidth": 2
      }
    },
    "opacity": {"condition": {"param": "state_highlight", "value": 1}, "value": 0.18},
    "tooltip": [
      {"field": "State"},
      {"field": "Year"}, 
      {"field": "overall_farm_income", "title": "Farm income ($M)", "format": ",.0f"}
    ]
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 22,
      "subtitleFontSize": 16,
      "fontWeight": "bold"
    }
  }
}
