{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": 600,
  "height": 560,
  "title": {"text": "Rainfall by State", "subtitle": "Use the dropdown to focus"},
  "data": {"url": "https://raw.githubusercontent.com/ndin0025/weather-agriculture-viz/refs/heads/main/final_merged_data.csv"},
  "params": [{"name": "State_select", "value": null, "bind": {"input": "select", "options": [null, "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"], "labels": ["Show all", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"], "name": "State: "}}],
  "transform": [{"filter": "State_select == null || datum.State == State_select"}],
  "mark": {"type": "bar", "tooltip": true, "cornerRadiusEnd": 3},
  "encoding": {
    "x": {
      "field": "State",
      "type": "nominal",
      "title": "State",
      "sort": "-y",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 14,
        "titleFontSize": 16
      }
    },
    "y": {
      "aggregate": "mean",
      "field": "annual_avg_rainfall",
      "type": "quantitative",
      "title": "Average rainfall (mm)",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 14,
        "titleFontSize": 16
      }
    },
    "color": {"field": "State", "type": "nominal", "legend": null, "scale": {"scheme": "set2"}},
    "tooltip": [{"field": "State"}, {"aggregate": "mean", "field": "annual_avg_rainfall", "title": "Average rainfall (mm)", "format": ",.0f"}]
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 22,
      "subtitleFontSize": 16,
      "fontWeight": "bold"
    }
  }
}
