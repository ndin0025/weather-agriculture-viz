{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 500,
  "title": {"text": "Average Temperature by State", "subtitle": "Mean yearly temperature"},
  "projection": {"type": "mercator"},
  "data": {"url": "https://raw.githubusercontent.com/ndin0025/weather-agriculture-viz/refs/heads/main/final_merged_data.csv"},
  "transform": [
    {"calculate": "datum.State == 'NSW' ? 'New South Wales' : datum.State == 'VIC' ? 'Victoria' : datum.State == 'QLD' ? 'Queensland' : datum.State == 'SA' ? 'South Australia' : datum.State == 'WA' ? 'Western Australia' : datum.State == 'TAS' ? 'Tasmania' : datum.State == 'NT' ? 'Northern Territory' : datum.State == 'ACT' ? 'Australian Capital Territory' : datum.State", "as": "State_full"},
    {"aggregate": [{"op": "mean", "field": "annual_avg_temp", "as": "avg_temp"}], "groupby": ["State", "State_full"]},
    {"lookup": "State_full", "from": {"data": {"url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson", "format": {"type": "json", "property": "features"}}, "key": "properties.STATE_NAME"}, "as": "geo"}
  ],
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
  "encoding": {
    "shape": {"field": "geo", "type": "geojson"},
    "color": {"field": "avg_temp", "type": "quantitative", "title": "Temp (°C)", "scale": {"scheme": "oranges"}},
    "tooltip": [{"field": "State_full", "title": "State"}, {"field": "avg_temp", "title": "Average temperature (°C)", "format": ".1f"}]
  },
  "config": {"view": {"stroke": null}, "font": "Inter"}
}
