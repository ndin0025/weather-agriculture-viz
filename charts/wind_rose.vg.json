{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": 600,
  "height": 620,
  "title": {
    "text": "Dominant Wind Gust Direction",
    "subtitle": "Wind rose style showing frequency by direction"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/ndin0025/weather-agriculture-viz/refs/heads/main/final_merged_data.csv"
  },
  "transform": [
    {
      "filter": "datum.most_common_wind_gust_dir != null && datum.most_common_wind_gust_dir != ''"
    },
    {
      "calculate": "datum.most_common_wind_gust_dir == 'N' ? 0 : datum.most_common_wind_gust_dir == 'NNE' ? 22.5 : datum.most_common_wind_gust_dir == 'NE' ? 45 : datum.most_common_wind_gust_dir == 'ENE' ? 67.5 : datum.most_common_wind_gust_dir == 'E' ? 90 : datum.most_common_wind_gust_dir == 'ESE' ? 112.5 : datum.most_common_wind_gust_dir == 'SE' ? 135 : datum.most_common_wind_gust_dir == 'SSE' ? 157.5 : datum.most_common_wind_gust_dir == 'S' ? 180 : datum.most_common_wind_gust_dir == 'SSW' ? 202.5 : datum.most_common_wind_gust_dir == 'SW' ? 225 : datum.most_common_wind_gust_dir == 'WSW' ? 247.5 : datum.most_common_wind_gust_dir == 'W' ? 270 : datum.most_common_wind_gust_dir == 'WNW' ? 292.5 : datum.most_common_wind_gust_dir == 'NW' ? 315 : 337.5",
      "as": "angle"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "frequency"
        }
      ],
      "groupby": [
        "most_common_wind_gust_dir",
        "angle"
      ]
    },
    {
      "calculate": "datum.angle - 11.25",
      "as": "angle_start"
    },
    {
      "calculate": "datum.angle + 11.25",
      "as": "angle_end"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 45,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "theta": {
          "field": "angle_start",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              360
            ],
            "range": [
              0,
              6.28318
            ]
          }
        },
        "theta2": {
          "field": "angle_end"
        },
        "radius": {
          "field": "frequency",
          "type": "quantitative",
          "scale": {
            "rangeMin": 55,
            "rangeMax": 170
          }
        },
        "color": {
          "field": "frequency",
          "type": "quantitative",
          "title": "Frequency",
          "scale": {
            "scheme": "yellowgreen"
          },
          "legend": {
            "titleFontSize": 18,
            "labelFontSize": 16,
            "gradientLength": 220,
            "gradientThickness": 20
          }
        },
        "tooltip": [
          {
            "field": "most_common_wind_gust_dir",
            "title": "Wind direction"
          },
          {
            "field": "frequency",
            "title": "Frequency"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "dir": "N",
            "angle": 0
          },
          {
            "dir": "NE",
            "angle": 45
          },
          {
            "dir": "E",
            "angle": 90
          },
          {
            "dir": "SE",
            "angle": 135
          },
          {
            "dir": "S",
            "angle": 180
          },
          {
            "dir": "SW",
            "angle": 225
          },
          {
            "dir": "W",
            "angle": 270
          },
          {
            "dir": "NW",
            "angle": 315
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold",
        "fill": "#213322"
      },
      "encoding": {
        "theta": {
          "field": "angle",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              360
            ],
            "range": [
              0,
              6.28318
            ]
          }
        },
        "radius": {
          "value": 195
        },
        "text": {
          "field": "dir"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "value": "Wind\ngust"
        },
        "color": {
          "value": "#213322"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 22,
      "subtitleFontSize": 16,
      "fontWeight": "bold"
    }
  }
}